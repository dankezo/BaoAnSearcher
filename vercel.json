{
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install && cd web && npm ci",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "regions": ["sin1"],
      "maxDuration": 300,
      "includeFiles": "web/public/data/suggest-static.json"
    }
  },
  "crons": [{ "path": "/api/regulatory-daily", "schedule": "0 23 * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__route=:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
