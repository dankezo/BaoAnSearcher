# Root .env — sync script (secrets NEVER commit)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Same URL/key for Vite (preferred names in this repo)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Aliases accepted by the SPA + Vercel API (Next-style docs)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Kho tìm kiếm production. Supabase/turso chỉ để rollback có chủ đích.
SEARCH_BACKEND=tidb
AUTH_MODE=local

# TiDB Serverless HTTP driver. Chỉ khi SEARCH_BACKEND=tidb.
# TIDB_DATABASE_URL=mysql://user:password@gateway.tidbcloud.com:4000/baoan
# Hoặc tách biến:
# TIDB_HOST=
# TIDB_PORT=4000
# TIDB_USER=
# TIDB_PASSWORD=
# TIDB_DATABASE=

# Cloudflare R2 public/custom-domain URLs for CSV snapshots. The admin API
# returns these URLs after authentication; the browser then downloads directly
# from R2 (no CSV bytes pass through Vercel or TiDB).
# R2_SNAPSHOT_DAV_URL=https://files.example.com/snapshots/dav.csv
# R2_SNAPSHOT_MSC_PRICE_URL=https://files.example.com/snapshots/msc-price.csv
# R2_SNAPSHOT_MSC_BID_URL=https://files.example.com/snapshots/msc-bid.csv
# R2_SNAPSHOT_VSS_URL=https://files.example.com/snapshots/vss.csv
# Optional displayed sizes, in MB:
# R2_SNAPSHOT_DAV_SIZE_MB=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=baoan-data-snapshots
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://pub-<bucket-id>.r2.dev

# Optional: enables read-only Vercel deployment health in Local Admin.
# Keep this server-side only; never use a VITE_ prefix.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=  # normally read automatically from .vercel/project.json

# Hybrid big-data layer (Turso / libSQL) — chỉ khi SEARCH_BACKEND=turso
TURSO_DATABASE_URL=libsql://baoan-searcher-XXXX.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_db_token

# Optional: legacy HS256 projects. Newer projects verify via JWKS and do not need this.
# SUPABASE_JWT_SECRET=

# Regulatory morning edition — server-only. Never use VITE_ for these secrets.
CRON_SECRET=generate_a_random_secret
GEMINI_API_KEY=your_dedicated_gemini_api_key

# Analytics — server-only, optional. Providers fall back Gemini -> Groq -> OpenRouter.
# ANALYTICS_GEMINI_MODEL=gemini-3.8-flash
# ANALYTICS_AI_PROVIDER=groq
# ANALYTICS_SNAPSHOT_BASE_URL=https://your-r2-custom-domain/analytics/
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# GEMINI_DAILY_MODEL=your_enabled_gemini_model
# Optional source discovery when the approved listing page cannot provide links.
# EXA_API_KEY=
# JINA_API_KEY=
# Discovery never treats search snippets as the original legal document.
