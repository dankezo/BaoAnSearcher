# Root .env — sync script (secrets NEVER commit)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Same URL/key for Vite (preferred names in this repo)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Aliases accepted by the SPA + Vercel API (Next-style docs)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Hybrid big-data layer (Turso / libSQL) — server-only on Vercel
TURSO_DATABASE_URL=libsql://baoan-searcher-XXXX.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_db_token
